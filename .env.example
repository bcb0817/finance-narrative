# X API
API_KEY=
API_KEY_SECRET=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=
# レポート機能（インプレ取得）で使う場合あり。Developer Portal の Keys and tokens から取得
BEARER_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_GENERATE_MODEL=gpt-5.4-mini
OPENAI_REVIEW_MODEL=gpt-5-nano
OPENAI_CLASSIFICATION_MODEL=gpt-5-nano
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_DEEP_ANALYSIS_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_USE_RESPONSES_API=true
OPENAI_FALLBACK_ENABLED=true
OPENAI_EMBEDDING_ENABLED=true
OPENAI_MODERATION_ENABLED=true
OPENAI_MODERATION_FAIL_CLOSED=true
OPENAI_DEEP_ANALYSIS_ENABLED=false
OPENAI_IMAGE_ENABLED=false
OPENAI_DUPLICATE_SIMILARITY_BLOCK=0.92
OPENAI_DUPLICATE_SIMILARITY_WARN=0.84
OPENAI_EMBEDDING_LOOKBACK_DAYS=30
OPENAI_TERRA_MAX_CALLS_PER_DAY=3
OPENAI_SOL_MAX_CALLS_PER_DAY=1
OPENAI_IMAGE_MAX_PER_DAY=0
OPENAI_MONTHLY_BUDGET_USD=5.0
OPENAI_BATCH_ENABLED=false
OPENAI_BATCH_COMPLETION_WINDOW=24h
OPENAI_BATCH_MAX_REQUESTS=100
OPENAI_BATCH_MAX_SUBMISSIONS_PER_DAY=2

# xAI X Search radar（X上の話題発見専用。投稿・事実確定には使わない）
XAI_API_KEY=
XAI_ENABLED=true
XAI_MODEL=grok-4.5
XAI_X_SEARCH_ENABLED=true
XAI_SEARCH_INTERVAL_MINUTES=60
XAI_RADAR_SCHEDULE_MODE=priority_windows
XAI_RADAR_RESERVED_CALLS_FOR_US_OPEN=2
XAI_RADAR_RESERVED_CALLS_FOR_EARNINGS=1
XAI_CACHE_TTL_MINUTES=60
XAI_MAX_SEARCH_CALLS_PER_DAY=2
XAI_EVENT_MAX_SEARCH_CALLS_PER_DAY=4
XAI_NORMAL_DAILY_RUN_LIMIT=2
XAI_EVENT_DAILY_RUN_LIMIT=4
XAI_EVENT_BURST_ENABLED=true
# FOMC/CPI/雇用統計/PCE/GDP等は公式カレンダーから自動判定。手動強制時だけtrue。
XAI_EVENT_MODE=false
XAI_RADAR_WATCH_HANDLES=
XAI_RADAR_MAX_TOPICS=5
XAI_RADAR_MAX_POSTS_PER_TOPIC=2
XAI_RADAR_MAX_ACCOUNTS_PER_TOPIC=2
# X Search results are read-only collective signals; retain at most 15 unique posts/day.
XAI_MAX_UNIQUE_POSTS_PER_DAY=15
XAI_MAX_OUTPUT_TOKENS=1400
XAI_TARGET_COST_PER_CALL_USD=0.10
XAI_SEARCH_TOOL_COST=0.005
XAI_MONTHLY_BUDGET_USD=20
XAI_FAIL_OPEN=true
EXPERIMENTS_ENABLED=true
MAX_ACTIVE_EXPERIMENTS=3
MIN_EXPERIMENT_SAMPLE_PER_VARIANT=10
QUOTE_QUEUE_ENABLED=false
QUOTE_QUEUE_MAX_PER_DAY=3
ALERTS_ENABLED=true
ALERT_CONSECUTIVE_FAILURE_THRESHOLD=3
ALERT_HEARTBEAT_STALE_MINUTES=10
DAILY_LOG_ANALYSIS_ENABLED=true
DAILY_LOG_ANALYSIS_LOOKBACK_HOURS=24
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_POST_NOTIFICATIONS_ENABLED=false
# One concise result per completed xAI research run; raw logs are never forwarded.
DISCORD_XAI_NOTIFICATIONS_ENABLED=true
DISCORD_LOGS_ENABLED=false
DISCORD_LOG_LEVEL=INFO
DISCORD_LOG_MAX_BATCHES_PER_FLUSH=5
METRICS_1H_WINDOW_START_MINUTES=45
METRICS_1H_WINDOW_END_MINUTES=90
METRICS_6H_WINDOW_START_MINUTES=330
METRICS_6H_WINDOW_END_MINUTES=420
METRICS_24H_WINDOW_START_MINUTES=1380
METRICS_24H_WINDOW_END_MINUTES=1620

# Finnhub
FINNHUB_API_KEY=
FINNHUB_ECON=0

# Public identity / HTTP identification (replace only in your local .env)
DIAGRAM_HANDLE=@finance_example
RSS_USER_AGENT=example-finance-bot/1.0
RSS_MAX_CANDIDATES_PER_PUBLISHER=3
RSS_FETCH_TIMEOUT_SECONDS=12
RSS_MAX_RESPONSE_BYTES=2000000
SEC_USER_AGENT=example-finance-bot bot-contact@example.com

# Runtime
TZ=Asia/Tokyo
# POST_ENABLED=false のときは実投稿しない（dry-run: 判定・画像生成まで実行）。
# 本番投稿する場合のみ true にする:
# POST_ENABLED=true
POST_ENABLED=false

# Paths
STATE_DIR=data
OUTPUT_DIR=outputs
LOG_DIR=logs

# News Bot
NEWS_DEFAULT_MODE=image
NEWS_RUN_EVERY_MINUTES=30
NEWS_MAX_POSTS_PER_RUN=1

# Global volume and cost guardrails (all X writes, including replies)
DAILY_POST_LIMIT=30
DAILY_POST_TARGET=20
DAILY_GOAL_AUTO_TUNE_ENABLED=true
DAILY_GOAL_DAILY_LIMIT_HARD_MAX=40
DAILY_GOAL_HOURLY_LIMIT_HARD_MAX=4
DAILY_GOAL_X_WRITE_BUDGET_HARD_MAX_USD=20
SAFETY_REVIEW_RETRY_LIMIT=0
HOURLY_POST_LIMIT=2
TICKER_COOLDOWN_MINUTES=180
THEME_COOLDOWN_MINUTES=90
THREADS_ENABLED=false
X_CONTENT_CREATE_USD=0.015
X_WRITE_MONTHLY_BUDGET_USD=15.0
# --- News Bot 投稿ゲート（通過率チューニング。数字を下げると通りやすい）---
NEWS_POST_VALUE_THRESHOLD=7
NEWS_RELEVANCE_THRESHOLD=8
NEWS_BUZZ_THRESHOLD=8
NEWS_NARRATIVE_THRESHOLD=8
NEWS_THEME_THRESHOLD=8
# 最終実投稿からこの時間を超えた場合、通常ゲート未通過候補の最良1件を投稿候補にする。
NEWS_IDLE_FALLBACK_HOURS=3
DYNAMIC_POSTING_ENABLED=true
QUIET_MIN_GAP_MINUTES=60
QUIET_MAX_GAP_MINUTES=120
HIGH_VELOCITY_MAX_POSTS_PER_HOUR=2
X_TOPIC_ACCELERATION_MINIMUM=1.25
DISCORD_QUOTE_QUEUE_ENABLED=false
QUOTE_DRAFT_AI_ENABLED=true
THREAD_AUTO_POST_ENABLED=false
# 評価済みニュースの再評価を抑制する時間（時間）
EVALUATED_TTL_HOURS=6

# Narrative Bot
NARRATIVE_POST_VALUE_THRESHOLD=8

# Market Map 投稿ゲート（大きな市場変化があるときだけ投稿）
MARKET_MAP_MIN_ABS_CHANGE_USD=500000000000
MARKET_MAP_MIN_INDEX_PCT=1.0
MARKET_MAP_SECTOR_SKEW=0.7
MARKET_MAP_MIN_BREADTH_RATIO=0.7
MARKET_MAP_MIN_SECTOR_PCT=1.5
MARKET_MAP_MIN_INTRADAY_REVERSAL_PCT=0.75

# Scheduler
RUN_WINDOW_MINUTES=10
CATCH_UP_ENABLED=false
LOCK_FILE=data/finance_bot.lock

